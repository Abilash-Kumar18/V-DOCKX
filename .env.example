# ==============================================================================
# V-DOCKX Environment Configuration
# ==============================================================================

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# Frontend Configuration
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# External URLs (Set to your domain or LAN IP for remote access)
# Examples:
#   Local lab:       http://192.168.1.100:8000
#   Nginx gateway:   http://192.168.1.100
#   Production SSL:  https://dock.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
